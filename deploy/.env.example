# .env.example — 環境変数テンプレート
# このファイルをコピーして .env.prod を作成し、値を設定すること
# cp .env.example .env.prod
# .env.prod は gitignore 対象。コミット禁止。

# ===== フロントエンド（ビルド時に焼き込まれる） =====
VITE_LIFF_ID=PLACEHOLDER
VITE_API_BASE_URL=https://LIFF_DOMAIN/api

# ===== バックエンドAPI =====
NODE_ENV=production

# JWT
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

# ===== LINE =====
LINE_CHANNEL_SECRET=CHANGE_ME
LINE_CHANNEL_ACCESS_TOKEN=CHANGE_ME
LINE_LOGIN_CHANNEL_ID=CHANGE_ME

# ===== PostgreSQL =====
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_16

# ===== MinIO =====
MINIO_ROOT_USER=CHANGE_ME_openssl_rand_hex_10
MINIO_ROOT_PASSWORD=CHANGE_ME_openssl_rand_hex_20
MINIO_BUCKET=receipts

# ===== アプリケーション設定 =====
HQ_WEB_URL=https://HQ_DOMAIN

# ===== Google（使用しない場合は false） =====
USE_GOOGLE_VISION=false
USE_GOOGLE_SHEETS=false
GOOGLE_SPREADSHEET_ID=
